AZURE_OPENAI_API_KEY=your-azure-api-key-here

# Data backend: "mysql" (GCP Cloud SQL, default) or "sqlite" (local db/refund_service.db)
DB_BACKEND=mysql
GCP_MYSQL_HOST=your-gcp-mysql-host
GCP_MYSQL_USER=your-mysql-user
GCP_MYSQL_PASSWORD=your-mysql-password
GCP_MYSQL_DATABASE=idox_appdata_derrick
GCP_MYSQL_CONNECT_TIMEOUT=5
