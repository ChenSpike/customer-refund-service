# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=replace-me
AZURE_OPENAI_DEPLOYMENT=replace-me
AZURE_OPENAI_API_VERSION=2025-03-01-preview
AZURE_OPENAI_MAX_OUTPUT_TOKENS=2400
AZURE_OPENAI_TEMPERATURE=0
AZURE_OPENAI_REQUEST_TIMEOUT_SECONDS=60
AZURE_OPENAI_MAX_RETRIES=2

# Pin only for deterministic demonstrations/tests; omit for the current date.
POLICY_EVALUATION_DATE=2026-07-01
# Optional per-stage overrides; otherwise AZURE_OPENAI_DEPLOYMENT is used.
# AZURE_OPENAI_TRIAGE_DEPLOYMENT=replace-me
# AZURE_OPENAI_RESPONSE_DEPLOYMENT=replace-me

# MySQL
MYSQL_HOST=replace-me
MYSQL_PORT=3306
MYSQL_USER=replace-me
MYSQL_PASSWORD=replace-me
MYSQL_DATABASE=final
MYSQL_CONNECT_TIMEOUT=10
