# Copy to .env and fill in real values from your team's secret manager.

# Database (direct connection mode — set these three and DB_HOST takes priority
# over the GCP Workload Identity Federation vars below)
DB_HOST=your-db-host
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=main_db
DB_PORT=3306

# Cloud SQL Connector + Workload Identity Federation (production/Vercel only —
# leave unset for local dev if DB_HOST is set above)
# GCP_PROJECT_NUMBER=
# GCP_SERVICE_ACCOUNT_EMAIL=
# GCP_WORKLOAD_IDENTITY_POOL_ID=
# GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
# DB_INSTANCE_CONNECTION_NAME=

# FastAPI
DEBUG=True
API_HOST=0.0.0.0
API_PORT=8000

# Frontend
REACT_APP_API_URL=http://localhost:8000
